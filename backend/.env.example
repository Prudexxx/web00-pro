# Runtime server
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
SERVICE_NAME=web00-backend
DATABASE_URL="postgresql://web00_prisma_user:password@127.0.0.1:5433/web00_backend_dev?schema=public"

# Migration tooling
SHADOW_DATABASE_URL="postgresql://web00_prisma_user:password@127.0.0.1:5433/web00_backend_shadow?schema=public"

# Test only
TEST_DATABASE_URL="postgresql://web00_prisma_user:password@127.0.0.1:5433/web00_backend_test?schema=public"

# Authentication
JWT_ACCESS_SECRET_BASE64="replace-with-32-byte-minimum-base64-secret"
JWT_ISSUER=web00-backend
JWT_AUDIENCE=web00-admin
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=604800
# Production AUTH_ORIGIN must be one exact HTTPS origin.
AUTH_ORIGIN=http://127.0.0.1:3000
AUTH_FINGERPRINT_SECRET_BASE64="replace-with-different-32-byte-minimum-base64-secret"
TRUST_PROXY_HOPS=0

# Public CORS
# Production PUBLIC_CORS_ORIGINS must contain exact HTTPS origins, comma-separated, max 10.
PUBLIC_CORS_ORIGINS=

# Storage
SUPABASE_URL=https://replace-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY="replace-with-service-role-key"
SUPABASE_STORAGE_BUCKET=web00-catalog-images
STORAGE_PUBLIC_BASE_URL=https://replace-project-ref.supabase.co

# Cleanup worker
STORAGE_WORKER_ENABLED=false
STORAGE_WORKER_POLL_INTERVAL_SECONDS=60
