NODE_ENV=development
PORT=3000
LOG_LEVEL=info
SERVICE_NAME=web00-backend

DATABASE_URL="postgresql://web00_prisma_user:password@127.0.0.1:5433/web00_backend_dev?schema=public"
SHADOW_DATABASE_URL="postgresql://web00_prisma_user:password@127.0.0.1:5433/web00_backend_shadow?schema=public"
TEST_DATABASE_URL="postgresql://web00_prisma_user:password@127.0.0.1:5433/web00_backend_test?schema=public"

JWT_ACCESS_SECRET_BASE64="replace-with-32-byte-minimum-base64-secret"
JWT_ISSUER=web00-backend
JWT_AUDIENCE=web00-admin
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=604800
AUTH_ORIGIN=http://127.0.0.1:3000
AUTH_FINGERPRINT_SECRET_BASE64="replace-with-different-32-byte-minimum-base64-secret"
TRUST_PROXY_HOPS=0
