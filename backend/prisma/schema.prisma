generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id              String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email           String           @unique(map: "users_email_key") @db.Text
  passwordHash    String           @map("password_hash") @db.Text
  role            String           @default("editor") @db.Text
  active          Boolean          @default(true)
  lastLoginAt     DateTime?        @map("last_login_at") @db.Timestamptz(6)
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  refreshSessions RefreshSession[]
  auditLogs       AuditLog[]

  @@index([active, role], map: "idx_users_active_role")
  @@map("users")
}

model RefreshSession {
  id                  String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId              String          @map("user_id") @db.Uuid
  tokenHash           String          @unique(map: "refresh_sessions_token_hash_key") @map("token_hash") @db.Text
  familyId            String          @map("family_id") @db.Uuid
  replacedBySessionId String?         @unique(map: "refresh_sessions_replaced_by_session_id_key") @map("replaced_by_session_id") @db.Uuid
  revokedAt           DateTime?       @map("revoked_at") @db.Timestamptz(6)
  expiresAt           DateTime        @map("expires_at") @db.Timestamptz(6)
  ipHash              String?         @map("ip_hash") @db.Text
  userAgentHash       String?         @map("user_agent_hash") @db.Text
  createdAt           DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)
  user                User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  replacedBySession   RefreshSession? @relation("RefreshSessionReplacement", fields: [replacedBySessionId], references: [id], onDelete: SetNull)
  replacementSource   RefreshSession? @relation("RefreshSessionReplacement")

  @@index([userId, expiresAt], map: "idx_refresh_sessions_user_expires")
  @@index([familyId, revokedAt], map: "idx_refresh_sessions_family_revoked")
  @@map("refresh_sessions")
}

model Category {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug        String   @unique(map: "categories_slug_key") @db.Text
  title       String   @db.Text
  description String?  @db.Text
  sortOrder   Int      @default(0) @map("sort_order")
  active      Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  sites       Site[]

  @@index([active, sortOrder], map: "idx_categories_active_sort_order")
  @@map("categories")
}

model Site {
  id                 String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug               String             @unique(map: "sites_slug_key") @db.Text
  title              String             @db.Text
  categoryId         String             @map("category_id") @db.Uuid
  legacyTitle        String?            @map("legacy_title") @db.Text
  shortDescription   String             @map("short_description") @db.Text
  fullDescription    String?            @map("full_description") @db.Text
  features           String[]           @default([])
  tags               String[]           @default([])
  demoUrl            String?            @map("demo_url") @db.Text
  siteUrl            String?            @map("site_url") @db.Text
  previewImageUrl    String?            @map("preview_image_url") @db.Text
  previewAssetId     String?            @map("preview_asset_id") @db.Uuid
  galleryImages      Json               @default("[]") @map("gallery_images") @db.JsonB
  previewType        String?            @map("preview_type") @db.Text
  demoMode           String?            @map("demo_mode") @db.Text
  demoLocalUrl       String?            @map("demo_local_url") @db.Text
  externalDemoUrl    String?            @map("external_demo_url") @db.Text
  originalDemoUrl    String?            @map("original_demo_url") @db.Text
  priceAmountCents   Int?               @map("price_amount_cents")
  priceLabel         String?            @map("price_label") @db.Text
  developmentDays    Int?               @map("development_days")
  deliveryLabel      String?            @map("delivery_label") @db.Text
  status             String             @default("draft") @db.Text
  active             Boolean            @default(true)
  featured           Boolean            @default(false)
  views              Int                @default(0)
  sortOrder          Int                @default(0) @map("sort_order")
  publishedAt        DateTime?          @map("published_at") @db.Timestamptz(6)
  deletedAt          DateTime?          @map("deleted_at") @db.Timestamptz(6)
  createdAt          DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)
  category           Category           @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  imageAssets        SiteImageAsset[]
  previewImage       SitePreviewImage?
  galleryImageAssets SiteGalleryImage[]

  @@index([status, active, deletedAt], map: "idx_sites_status_active_deleted")
  @@index([categoryId, status, active, deletedAt], map: "idx_sites_category_public")
  @@index([featured, views, sortOrder, createdAt], map: "idx_sites_featured_order")
  @@index([tags], type: Gin, map: "idx_sites_tags_gin")
  @@index([features], type: Gin, map: "idx_sites_features_gin")
  @@map("sites")
}

model AuditLog {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actorUserId   String?  @map("actor_user_id") @db.Uuid
  action        String   @db.Text
  entityType    String   @map("entity_type") @db.Text
  entityId      String?  @map("entity_id") @db.Uuid
  beforeJson    Json?    @map("before_json") @db.JsonB
  afterJson     Json?    @map("after_json") @db.JsonB
  requestId     String   @map("request_id") @db.Text
  ipHash        String?  @map("ip_hash") @db.Text
  userAgentHash String?  @map("user_agent_hash") @db.Text
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  actorUser     User?    @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([actorUserId, createdAt], map: "idx_audit_logs_actor_created")
  @@index([entityType, entityId], map: "idx_audit_logs_entity")
  @@index([action, createdAt], map: "idx_audit_logs_action_created")
  @@map("audit_logs")
}

model StorageCleanupJob {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  storagePath String    @map("storage_path") @db.Text
  reason      String    @db.Text
  entityType  String?   @map("entity_type") @db.Text
  entityId    String?   @map("entity_id") @db.Uuid
  status      String    @default("pending") @db.Text
  attempts    Int       @default(0)
  lastError   String?   @map("last_error") @db.Text
  runAfter    DateTime  @default(now()) @map("run_after") @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  completedAt DateTime? @map("completed_at") @db.Timestamptz(6)

  @@index([status, runAfter], map: "idx_storage_cleanup_jobs_status_run_after")
  @@index([entityType, entityId], map: "idx_storage_cleanup_jobs_entity")
  @@map("storage_cleanup_jobs")
}

model PublicCatalogControl {
  id                         String    @id @db.Text
  showDemoInModal            Boolean   @default(false) @map("show_demo_in_modal")
  desiredRevision            Int       @default(1) @map("desired_revision")
  publishedRevision          Int       @default(0) @map("published_revision")
  syncStatus                 String    @default("pending") @map("sync_status") @db.Text
  currentSnapshotPath        String?   @map("current_snapshot_path") @db.Text
  currentSnapshotChecksum    String?   @map("current_snapshot_checksum") @db.Text
  currentSnapshotGeneratedAt DateTime? @map("current_snapshot_generated_at") @db.Timestamptz(6)
  currentItemsCount          Int?      @map("current_items_count")
  lastSyncErrorCode          String?   @map("last_sync_error_code") @db.Text
  lastSyncRequestId          String?   @map("last_sync_request_id") @db.Text
  syncLeaseId                String?   @map("sync_lease_id") @db.Text
  syncLeaseExpiresAt         DateTime? @map("sync_lease_expires_at") @db.Timestamptz(6)
  createdAt                  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([syncStatus], map: "idx_public_catalog_control_sync_status")
  @@index([syncLeaseExpiresAt], map: "idx_public_catalog_control_sync_lease_expires_at")
  @@map("public_catalog_control")
}

model PublicCatalogSetting {
  id              String   @id @db.Text
  showDemoInModal Boolean  @default(true) @map("show_demo_in_modal")
  autoPublish     Boolean  @default(true) @map("auto_publish")
  desiredRevision Int      @default(1) @map("desired_revision")
  activeRevision  Int      @default(0) @map("active_revision")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("public_catalog_settings")
}

model SiteImageAsset {
  assetId            String             @id @map("asset_id") @db.Uuid
  siteId             String             @map("site_id") @db.Uuid
  slot               String             @db.Text
  sourceSha256       String             @map("source_sha256") @db.Char(64)
  sourceMime         String             @map("source_mime") @db.Text
  decodedFormat      String             @map("decoded_format") @db.Text
  width              Int
  height             Int
  storagePath        String             @map("storage_path") @db.Text
  variants           Json               @db.JsonB
  createdAt          DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  site               Site               @relation(fields: [siteId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  previewAssignments SitePreviewImage[] @relation("SitePreviewImageAsset")
  galleryAssignments SiteGalleryImage[] @relation("SiteGalleryImageAsset")

  @@unique([siteId, assetId, slot], map: "site_image_assets_site_asset_slot_key")
  @@map("site_image_assets")
}

model SitePreviewImage {
  siteId    String         @id @map("site_id") @db.Uuid
  assetId   String         @map("asset_id") @db.Uuid
  slot      String         @default("preview") @db.Text
  createdAt DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  site      Site           @relation(fields: [siteId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  asset     SiteImageAsset @relation("SitePreviewImageAsset", fields: [siteId, assetId, slot], references: [siteId, assetId, slot], onDelete: Restrict, onUpdate: Cascade)

  @@map("site_preview_images")
}

model SiteGalleryImage {
  siteId    String         @map("site_id") @db.Uuid
  assetId   String         @map("asset_id") @db.Uuid
  slot      String         @default("gallery") @db.Text
  sortOrder Int            @map("sort_order")
  alt       String         @default("") @db.Text
  createdAt DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  site      Site           @relation(fields: [siteId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  asset     SiteImageAsset @relation("SiteGalleryImageAsset", fields: [siteId, assetId, slot], references: [siteId, assetId, slot], onDelete: Cascade, onUpdate: Cascade)

  @@id([siteId, assetId], map: "site_gallery_images_pkey")
  @@unique([siteId, sortOrder], map: "site_gallery_images_site_sort_order_key")
  @@map("site_gallery_images")
}

model PublicCatalogPublicationOperation {
  id                 String                        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  idempotencyKey     String                        @unique(map: "public_catalog_publication_operations_idempotency_key_key") @map("idempotency_key") @db.Text
  action             String                        @db.Text
  requestFingerprint String                        @map("request_fingerprint") @db.Char(64)
  projectionHash     String?                       @map("projection_hash") @db.Char(64)
  operationScope     String                        @map("operation_scope") @db.Text
  operationGroupKey  String                        @map("operation_group_key") @db.Text
  trigger            String                        @db.Text
  actorUserId        String?                       @map("actor_user_id") @db.Uuid
  siteId             String?                       @map("site_id") @db.Uuid
  targetRevision     Int                           @map("target_revision")
  status             String                        @db.Text
  stage              String                        @db.Text
  retryCount         Int                           @default(0) @map("retry_count")
  nextRetryAt        DateTime?                     @map("next_retry_at") @db.Timestamptz(6)
  leaseId            String?                       @map("lease_id") @db.Text
  lockedAt           DateTime?                     @map("locked_at") @db.Timestamptz(6)
  lockedBy           String?                       @map("locked_by") @db.Text
  lastCheckpoint     Json                          @default("{}") @map("last_checkpoint") @db.JsonB
  lastErrorCode      String?                       @map("last_error_code") @db.Text
  requestId          String                        @map("request_id") @db.Text
  createdAt          DateTime                      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime                      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  completedAt        DateTime?                     @map("completed_at") @db.Timestamptz(6)
  activationEvent    PublicCatalogActivationEvent?

  @@index([targetRevision, createdAt], map: "public_catalog_publication_operations_target_revision_idx")
  @@map("public_catalog_publication_operations")
}

model PublicCatalogRelease {
  revision                 Int                            @id
  status                   String                         @db.Text
  itemsCount               Int                            @map("items_count")
  chunksCount              Int                            @map("chunks_count")
  popularCount             Int                            @map("popular_count")
  manifestPath             String                         @map("manifest_path") @db.Text
  manifestSha256           String                         @map("manifest_sha256") @db.Char(64)
  indexPath                String                         @map("index_path") @db.Text
  indexSha256              String                         @map("index_sha256") @db.Char(64)
  popularPath              String                         @map("popular_path") @db.Text
  popularSha256            String                         @map("popular_sha256") @db.Char(64)
  categoriesPath           String                         @map("categories_path") @db.Text
  categoriesSha256         String                         @map("categories_sha256") @db.Char(64)
  activePointerSha256      String?                        @map("active_pointer_sha256") @db.Char(64)
  generatedAt              DateTime                       @map("generated_at") @db.Timestamptz(6)
  activatedAt              DateTime?                      @map("activated_at") @db.Timestamptz(6)
  activationEvents         PublicCatalogActivationEvent[] @relation("ActivationEventRevision")
  previousActivationEvents PublicCatalogActivationEvent[] @relation("ActivationEventPreviousRevision")

  @@index([status, revision], map: "public_catalog_releases_status_revision_idx")
  @@map("public_catalog_releases")
}

model PublicCatalogActivationEvent {
  id                  String                             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  operationId         String?                            @unique(map: "public_catalog_activation_events_operation_id_key") @map("operation_id") @db.Uuid
  eventType           String                             @map("event_type") @db.Text
  revision            Int
  previousRevision    Int?                               @map("previous_revision")
  activePointerSha256 String                             @map("active_pointer_sha256") @db.Char(64)
  requestId           String                             @map("request_id") @db.Text
  createdAt           DateTime                           @default(now()) @map("created_at") @db.Timestamptz(6)
  operation           PublicCatalogPublicationOperation? @relation(fields: [operationId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  release             PublicCatalogRelease               @relation("ActivationEventRevision", fields: [revision], references: [revision], onDelete: Restrict, onUpdate: Cascade)
  previousRelease     PublicCatalogRelease?              @relation("ActivationEventPreviousRevision", fields: [previousRevision], references: [revision], onDelete: Restrict, onUpdate: Cascade)

  @@index([revision, eventType, createdAt], map: "public_catalog_activation_events_revision_type_idx")
  @@map("public_catalog_activation_events")
}
